# Copie para .env.local (desenvolvimento) e preencha com as suas credenciais.
# NUNCA comite credenciais reais.

# PostgreSQL da aplicação.
DATABASE_URL=postgres://usuario:senha@127.0.0.1:5432/konvert

# PostgreSQL usado pelos testes de integração (pnpm test:integration).
# Este é o valor que `pnpm db:test:up` disponibiliza localmente.
TEST_DATABASE_URL=postgres://konvert:konvert@127.0.0.1:55432/konvert_test

# Origem pública da aplicação. Usada para validar o header Origin nas rotas
# que alteram dados (quando o header estiver presente).
APP_ORIGIN=http://localhost:3000

# Versão do texto de consentimento vigente, registrada junto de cada
# consentimento aceito.
CONSENT_TEXT_VERSION=2026-09-06.v1
